    {
      "name": "local_user_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_user_profiles\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"display_name\" TEXT NULL, \"state\" TEXT NOT NULL DEFAULT 'guest', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "account_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"account_metadata\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL REFERENCES local_user_profiles (id) ON DELETE CASCADE, \"auth_uid\" TEXT NOT NULL UNIQUE, \"providers\" TEXT NOT NULL DEFAULT '[]', \"email\" TEXT NULL, \"display_name\" TEXT NULL, \"photo_url\" TEXT NULL, \"last_sign_in_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "persons",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"persons\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"row_version\" INTEGER NOT NULL DEFAULT 1, \"id\" TEXT NOT NULL, \"owner_profile_id\" TEXT NOT NULL REFERENCES local_user_profiles (id), \"full_name\" TEXT NOT NULL, \"display_name\" TEXT NULL, \"birth_date\" TEXT NULL, \"gender\" TEXT NULL, \"phone\" TEXT NULL, \"email\" TEXT NULL, \"address\" TEXT NULL, \"occupation\" TEXT NULL, \"organization\" TEXT NULL, \"notes\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "person_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"person_categories\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"system_key\" TEXT NULL UNIQUE, \"name\" TEXT NULL, \"color\" INTEGER NULL, \"icon\" TEXT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"is_system\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_system\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "person_category_relations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"person_category_relations\" (\"person_id\" TEXT NOT NULL REFERENCES persons (id) ON DELETE CASCADE, \"category_id\" TEXT NOT NULL REFERENCES person_categories (id) ON DELETE CASCADE, PRIMARY KEY (\"person_id\", \"category_id\"));"
        }
      ]
    },
    {
      "name": "event_types",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"event_types\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"system_key\" TEXT NULL UNIQUE, \"name\" TEXT NULL, \"icon\" TEXT NULL, \"color\" INTEGER NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"is_system\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_system\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recurrence_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurrence_rules\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" TEXT NOT NULL, \"freq\" TEXT NOT NULL, \"interval\" INTEGER NOT NULL DEFAULT 1, \"by_weekday\" TEXT NULL, \"by_month_day\" INTEGER NULL, \"by_month\" INTEGER NULL, \"by_set_pos\" INTEGER NULL, \"until_date\" TEXT NULL, \"count\" INTEGER NULL, \"overflow_policy\" TEXT NOT NULL DEFAULT 'clamp_to_last_day', PRIMARY KEY (\"id\"), CHECK (\"interval\" >= 1), CHECK (NOT (until_date IS NOT NULL AND count IS NOT NULL)));"
        }
      ]
    },
    {
      "name": "events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"events\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"row_version\" INTEGER NOT NULL DEFAULT 1, \"id\" TEXT NOT NULL, \"owner_profile_id\" TEXT NOT NULL REFERENCES local_user_profiles (id), \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"event_type_id\" TEXT NOT NULL REFERENCES event_types (id) ON DELETE RESTRICT, \"start_date\" TEXT NOT NULL, \"start_time\" TEXT NULL, \"end_date\" TEXT NULL, \"end_time\" TEXT NULL, \"all_day\" INTEGER NOT NULL DEFAULT 1 CHECK (\"all_day\" IN (0, 1)), \"tz_id\" TEXT NULL, \"location\" TEXT NULL, \"priority\" TEXT NOT NULL DEFAULT 'normal', \"color\" INTEGER NULL, \"status\" TEXT NOT NULL DEFAULT 'planned', \"recurrence_rule_id\" TEXT NULL REFERENCES recurrence_rules (id) ON DELETE SET NULL, \"notes\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (end_date IS NULL OR end_date >= start_date));"
        }
      ]
    },
